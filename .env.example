# ─── Prestwell Continuum — Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.prestwellcontinuum.com

# ─── Email (Resend — recommended) ─────────────────────────────────────────────
# Sign up at https://resend.com — generous free tier
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL=care@prestwellcontinuum.com

# ─── Alternative: SendGrid ─────────────────────────────────────────────────────
# SENDGRID_API_KEY=SG.your_api_key_here

# ─── Analytics (optional) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxx

# ─── Scheduling (future — Calendly) ───────────────────────────────────────────
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/prestwellcontinuum/consultation

# ─── Payments (future — Stripe) ────────────────────────────────────────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
